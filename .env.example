# By Angély — Variáveis de Ambiente do Servidor (Render / Produção)
# Copie para .env apenas localmente. No Render, configure em Environment Variables.

PORT=3000
NODE_ENV=production

# Supabase (Região sa-east-1 São Paulo)
SUPABASE_URL=https://mhtsubybvriffashamiy.supabase.co
SUPABASE_ANON_KEY=sua_chave_anon_publica_aqui
# ATENÇÃO: SUPABASE_SERVICE_ROLE_KEY deve ficar SOMENTE nas variáveis de ambiente do backend (Render)
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_secreta_aqui

# Segredo de sessão administrativa do backend
ADMIN_SESSION_SECRET=configure_um_segredo_forte_no_render
